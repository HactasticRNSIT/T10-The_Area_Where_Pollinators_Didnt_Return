# API Keys
GROQ_API_KEY=your_groq_api_key_here
POLYNEXUS_API_KEY=your_secure_api_key

# Feature Flags
# Set to "1" to enable the /interventions/efficacy endpoint. Left as "0" to keep hidden until public launch.
ENABLE_EFFICACY_ENDPOINT=0

# Raise the /analyse rate limit for load testing ONLY. Default (1/second) applies when unset.
# Example: ANALYSE_RATE_LIMIT=200/minute  — NEVER set in production.
ANALYSE_RATE_LIMIT=1/second

# Raise the /compare rate limit for load testing ONLY. Default (2/minute) applies when unset.
# Example: COMPARE_RATE_LIMIT=60/minute  — NEVER set in production.
COMPARE_RATE_LIMIT=2/minute

# Set to "1" to store the full analysis result JSON blob in the history store.
# Default (0) stores only summary scalar columns, avoiding a GIL-holding
# json.dumps on every background save_run call. Enable only for diagnostics.
POLYNEXUS_HISTORY_RAW=0

# Load Testing
# Set to "1" to bypass live data fetches and return mocked data. WARNING: Do not use in production!
POLYNEXUS_MOCK_EXTERNAL=0

# Database paths (optional — defaults to ../data/ relative to backend/)
# Keep OBSERVATIONS_DB_PATH and HISTORY_DB_PATH pointing to DIFFERENT files
# so WAL checkpoint stalls on the write-heavy history store never block
# read-only observation queries.
# HISTORY_DB_PATH=../data/polynexus_history.db
# OBSERVATIONS_DB_PATH=../data/polynexus_observations.db
